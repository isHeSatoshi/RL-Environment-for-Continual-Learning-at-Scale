    "sccl_replay_learners": ["sccl_replay", "sccl_v2"],
    "sccl_replay_k": 2,
    "sccl_probe_learners": ["sccl_probe", "sccl_v2"],
    "sccl_probes": 1,
    "sccl_probe_check": 2,
    "sccl_rrv_math": 2,
    "self_taught_learners": ["vsr_nogold"],
    "out_dir": "runs/sccl_v2",
    "seed": 42
