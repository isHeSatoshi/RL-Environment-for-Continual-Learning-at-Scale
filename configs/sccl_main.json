{
  "_comment": "SCCL main run — the gold-free ladder vs gold baselines. 4 families (mbpp arith / math / mbpp string / drifted spec_perturb) x 8 train tasks. Learner ladder: frozen < selfdistill < execfilter (unsafe, no gold gate) < sccl_nocons < sccl (ours, gold-free + RRV) < sccl_nogate (ablation) < vsr_nogold (gold tests, STaR-style) < vsr (gold upper bound).",
  "stream": {
    "seed": 42,
    "families": [
      {"corpus": "mbpp", "name": "arith", "n_train": 8, "n_holdout": 4, "offset": 0},
      {"corpus": "math", "name": "math_word", "n_train": 8, "n_holdout": 4, "offset": 0},
      {"corpus": "mbpp", "name": "string", "n_train": 8, "n_holdout": 4, "offset": 12},
      {"corpus": "mbpp", "name": "drift", "n_train": 8, "n_holdout": 4, "offset": 24, "drift": {"kind": "spec_perturb"}}
    ]
  },
  "experiment": {
    "model_name": "Qwen/Qwen2.5-Coder-3B-Instruct",
    "lora_r": 16,
    "lora_alpha": 32,
    "learning_rate": 0.0003,
    "train_steps_per_update": 4,
    "max_updates": 60,
    "temperature": 0.1,
    "max_new_tokens": 256,
    "gate_epsilon": 0.05,
    "holdout_size": 8,
    "use_vsr_gate": true,
    "use_reference_injection": true,
    "vsr_learners": ["vsr"],
    "refinject_learners": ["vsr"],
    "vault_commit_min": 0.9,
    "vault_retrieve_k": 3,
    "vault_gate_check": 3,
    "sccl_learners": ["sccl", "sccl_nocons"],
    "sccl_nogate_learners": ["sccl_nogate"],
    "sccl_nocons_learners": ["sccl_nocons"],
    "sccl_k": 6,
    "sccl_temp": 0.8,
    "sccl_test_bags": 2,
    "sccl_tests_per_bag": 4,
    "sccl_tau": 0.65,
    "sccl_tau_math": 0.6,
    "sccl_derive_entry": true,
    "sccl_replay_check": 3,
    "sccl_replay_samples": 2,
    "sccl_gate_probe": 4,
    "self_taught_learners": ["vsr_nogold", "vsr_self"],
    "out_dir": "runs/sccl_main",
    "seed": 42
  },
  "learners": ["frozen", "selfdistill", "execfilter", "sccl_nocons", "sccl", "sccl_nogate", "vsr_nogold", "vsr"],
  "out_dir": "runs/sccl_main"
}
