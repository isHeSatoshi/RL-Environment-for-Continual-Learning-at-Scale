{
  "_comment": "SCCL quick signal run — debug the gold-free pipeline end-to-end on Qwen2.5-Coder-3B. 3 families x 3 train tasks; SCCL learner only.",
  "stream": {
    "seed": 42,
    "families": [
      {"corpus": "mbpp", "name": "arith", "n_train": 3, "n_holdout": 2, "offset": 0},
      {"corpus": "math", "name": "math_word", "n_train": 3, "n_holdout": 2, "offset": 0},
      {"corpus": "mbpp", "name": "string", "n_train": 3, "n_holdout": 2, "offset": 12}
    ]
  },
  "experiment": {
    "model_name": "Qwen/Qwen2.5-Coder-3B-Instruct",
    "lora_r": 16,
    "lora_alpha": 32,
    "learning_rate": 0.0003,
    "train_steps_per_update": 4,
    "max_updates": 20,
    "temperature": 0.1,
    "max_new_tokens": 256,
    "gate_epsilon": 0.05,
    "holdout_size": 6,
    "sccl_learners": ["sccl"],
