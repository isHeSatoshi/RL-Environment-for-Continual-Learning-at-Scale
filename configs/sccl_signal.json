    "sccl_test_bags": 2,
    "sccl_tests_per_bag": 3,
    "sccl_tau": 0.65,
    "sccl_tau_math": 0.6,
    "sccl_derive_entry": true,
    "sccl_replay_check": 2,
    "sccl_replay_samples": 2,
    "sccl_gate_probe": 2,
    "out_dir": "runs/sccl_signal",
    "seed": 42
  },
  "learners": ["sccl"],
  "out_dir": "runs/sccl_signal"
}
